# PostgreSQL
DATABASE_URL=postgresql+psycopg2://recruit_user:password@db:5432/recruitment_db
POSTGRES_USER=recruit_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=recruitment_db

# JWT
JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Redis
REDIS_URL=redis://redis:6379/0

# Locust Load Testing
LOCUST_EMAIL=your_test_admin@example.com
LOCUST_PASSWORD=your_test_password

# CORS
CORS_ORIGINS=http://localhost:5173
